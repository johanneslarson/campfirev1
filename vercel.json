{
  "version": 2,
  "routes": [
    {
      "src": "/api/artists",
      "dest": "/api/artists.ts"
    },
    {
      "src": "/api/artists/(.*)",
      "dest": "/api/artists.ts"
    },
    {
      "src": "/api/tracks",
      "dest": "/api/tracks.ts"
    },
    {
      "src": "/api/tracks/(.*)",
      "dest": "/api/tracks.ts"
    },
    {
      "src": "/api/communities",
      "dest": "/api/communities.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    }
  ]
} 